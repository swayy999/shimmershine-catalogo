# Copia este archivo a .env.local y completa los valores.
# .env.local nunca se sube a git (ya está en .gitignore).

# URL del CSV publicado de tu Google Sheet.
# Archivo > Compartir > Publicar en la web > selecciona la hoja > formato CSV.
GOOGLE_SHEET_CSV_URL=

# Número de WhatsApp de contacto (fijo, no editable en la página pública).
NEXT_PUBLIC_WHATSAPP_PHONE=+56966129549

# Cloud name de Cloudinary (público, se usa para armar URLs de imagen si en
# la planilla solo pones el nombre de archivo en vez de la URL completa).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=shimmershine

# Credenciales de Cloudinary SOLO para correr localmente
# "npm run subir-fotos" (no se usan en el sitio publicado, no son públicas).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa a las 3 de arriba: una sola variable
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
